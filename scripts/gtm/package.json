{
  "name": "gtm-analytics-scripts",
  "version": "1.0.0",
  "description": "GTM bulk setup scripts for GA4, Meta Pixel, CleverTap, Clarity, Google Ads",
  "type": "commonjs",
  "scripts": {
    "setup": "node setup.js",
    "setup:google-ads": "node setup-google-ads.js",
    "create-shared": "node create-shared-gtm-assets.js",
    "create-shared:dry": "DRY_RUN=true node create-shared-gtm-assets.js",
    "create-tags": "node create-ga4-tag.js",
    "create-tags:dry": "DRY_RUN=true node create-ga4-tag.js",
    "create-tags:ct": "node create-clevertap-tag.js",
    "create-tags:ct:dry": "DRY_RUN=true node create-clevertap-tag.js",
    "create-tags:meta": "node create-meta-tag.js",
    "create-tags:meta:dry": "DRY_RUN=true node create-meta-tag.js",
    "publish": "node publish.js"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "googleapis": "^171.0.0"
  }
}
